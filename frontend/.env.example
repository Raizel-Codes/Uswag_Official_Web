# Copy this file to .env and fill in real values. Never commit .env.

VITE_API_BASE_URL=http://localhost:4000/api/v1

# The public site's address, e.g. https://uswag.example.org — used for link previews on
# Facebook/Messenger (og:url, og:image). Leave empty locally; set it on Vercel.
VITE_SITE_URL=

# Web Push public VAPID key (paired with the private key on the backend)
VITE_VAPID_PUBLIC_KEY=

# Optional score for the front-page prequel film (a licensed 90 s track, e.g. on Cloudinary).
# Leave empty and the film plays silent, with no mute control.
VITE_PREQUEL_MUSIC_URL=

# Optional: analytics / error tracking keys go here later
