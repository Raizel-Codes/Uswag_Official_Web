// USWAG database schema.
// Roles and officer positions mirror Article VI of the Constitution —
// see /claude.md "Roles & permissions" before changing any enum here.
// Do not add new roles or officer positions without a corresponding
// Constitution amendment (Article IX).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  OFFICER_ADMIN
  MEMBER
}

enum OfficerPosition {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  TREASURER
  AUDITOR
  BUSINESS_MANAGER
  PRO
}

enum MembershipStatus {
  ACTIVE
  PENDING
  EXPIRED
  REJECTED
}

enum EventPillar {
  YOUTH_VOICE
  MENTAL_HEALTH
  ENVIRONMENTAL
}

enum EventScope {
  IN_CAMPUS
  OUT_OF_CAMPUS
}

enum EventStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ScanResult {
  VALID
  INVALID
  EXPIRED
}

enum PostSource {
  FACEBOOK
  MANUAL
}

model User {
  id               String           @id @default(uuid())
  name             String
  email            String           @unique
  passwordHash     String
  role             UserRole
  officerPosition  OfficerPosition? // set only when role is OFFICER_ADMIN or SUPER_ADMIN
  collegeOrDept    String
  yearLevel        String?
  navStyle         String           @default("auto") // 'auto', 'bottom', or 'sidebar'
  tokenVersion     Int              @default(1) // bump to invalidate every outstanding refresh token (logout-all / revocation)

  // Password reset. Only a SHA-256 hash of the raw token is ever stored —
  // same principle as the QR signing secret (crypto.ts): the raw token is
  // only in the reset link the user receives, never at rest in the DB, so a
  // DB leak alone can't be used to reset anyone's password.
  passwordResetTokenHash  String?
  passwordResetExpiresAt  DateTime?

  // Officer-assisted reset (no email): the person asks, an officer confirms who they are and issues a
  // one-time link (member.controller.ts reset-request endpoints). Open for 7 days; cleared when a link
  // is issued or the request dismissed. IdMatched: did the student ID they typed match the one on file?
  // (true / false; null = couldn't be checked — no ID on file.) Never the ID itself.
  passwordResetRequestedAt DateTime?
  passwordResetIdMatched   Boolean?

  // True for an account created by a friend-assisted application (the
  // helper never sets the applicant's password). The only password is an
  // unguessable random one until the applicant uses the one-time setup link
  // the Secretary gives them in person (member.controller.ts
  // createSetupLink); consumePasswordResetToken() clears this flag.
  awaitingPasswordSetup   Boolean  @default(false)

  // The site developer's account (scripts/create-developer.ts): a Super Admin who only OVERSEES. It can
  // see everything and change nothing (auth.middleware.ts), is never listed as an officer, and can reach
  // the /dev console. mustChangePassword: the password was handed over, so the person has to choose their
  // own at first login; nothing else works until they do.
  isDeveloper        Boolean  @default(false)
  mustChangePassword Boolean  @default(false)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  memberProfile      MemberProfile?
  scansPerformed     AttendanceRecord[] @relation("ScannedBy")
  postsAuthored      Post[]
  auditLogEntries    AuditLogEntry[]
  pushSubscriptions  PushSubscription[]
  notifications      Notification[]
  financeEntries     FinanceEntry[]
  purchaseRequests   PurchaseRequest[]
}

model MemberProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  serialNumber     String            @unique // e.g. UW-2026-004821, never sequential/guessable
  status           MembershipStatus  @default(PENDING)
  academicYear     String            // e.g. "2026-2027" — renewed per Article III §3

  // QR signing fields. The UUID (User.id) is what gets signed —
  // this table does not store the signature itself; it is derived
  // on demand in qr.service.ts using QR_SIGNING_SECRET.
  qrIssuedAt       DateTime?
  qrVersion        Int               @default(1) // bump to invalidate all previously issued QR codes

  joinedAt         DateTime          @default(now())
  expiresAt        DateTime?

  // Student ID (Article III applications). The raw ID is never stored in
  // plaintext — see utils/crypto.ts:
  // - studentIdHash: keyed HMAC of the normalized ID. Permanent. Only lets
  //   the server ask "has this ID applied before?"; it can't be turned back
  //   into the ID without STUDENT_ID_HASH_KEY. Unique = one application per
  //   student, even if they use a different email.
  // - studentIdCiphertext: AES-256-GCM, so the Secretary can read the ID
  //   while verifying the application. Temporary: set to null the moment
  //   the application is approved or rejected.
  // Both are null for members who joined before this field existed.
  studentIdHash       String?  @unique
  studentIdCiphertext String?

  // Friend-assisted application: someone else's device, the applicant
  // present. proxyName (who helped) is temporary like the ciphertext and is
  // cleared on approval/rejection; the boolean stays for the record.
  submittedByProxy Boolean  @default(false)
  proxyName        String?

  rsvps            EventRsvp[]
  attendance       AttendanceRecord[]
}

model UswagEvent {
  id             String       @id @default(uuid())
  title          String
  description    String
  pillar         EventPillar
  scope          EventScope
  status         EventStatus  @default(DRAFT)
  location       String
  startsAt       DateTime
  limitedSlots   Int?         // present only for limited out-of-campus activities

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  rsvps          EventRsvp[]
  attendance     AttendanceRecord[]
}

model EventRsvp {
  id         String         @id @default(uuid())
  eventId    String
  event      UswagEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId   String
  member     MemberProfile  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status     String         // "going" | "applied" | "waitlisted"
  createdAt  DateTime       @default(now())

  @@unique([eventId, memberId])
}

// Every scan attempt is logged — valid, invalid, AND expired.
// This is the mechanism that makes cloned/reused QR codes detectable:
// the same serial number scanned at two locations minutes apart is
// immediately visible here. See claude.md "QR membership system".
model AttendanceRecord {
  id                String        @id @default(uuid())
  eventId           String
  event             UswagEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId          String?       // null when the scanned QR didn't resolve to a known member
  member            MemberProfile? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  scannedByOfficerId String
  scannedByOfficer  User          @relation("ScannedBy", fields: [scannedByOfficerId], references: [id])
  result            ScanResult
  reason            String?       // populated when result != VALID (e.g. "signature mismatch", "membership expired")
  scannedAt         DateTime      @default(now())
}

model Post {
  id             String      @id @default(uuid())
  source         PostSource
  type           String      @default("NEWS") // "NEWS" | "MINUTE" | "ANNOUNCEMENT"
  body           String
  imageUrl       String?
  permalink      String?     @unique // Facebook post permalink, used for dedup
  facebookPostId String?     @unique // dedup key for synced posts
  authorId       String?     // null for Facebook-synced posts
  author         User?       @relation(fields: [authorId], references: [id])
  publishedAt    DateTime    @default(now())
  likeCount      Int?
  commentCount   Int?
}

model AmendmentLog {
  id            String   @id @default(uuid())
  articleRef    String   // e.g. "Article VI, Sec. 1"
  proposal      String
  proposedBy    String
  status        String   // "proposed" | "approved" | "rejected"
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
}

// System-wide action log for accountability — primarily viewed by the
// Auditor (read-only) and Super Admin. See claude.md "What NOT to do":
// don't let this be the only enforcement mechanism — it's a record, not a gate.
model AuditLogEntry {
  id          String   @id @default(uuid())
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id])
  action      String   // e.g. "member.approve", "event.create", "bylaws.amend"
  targetType  String?  // e.g. "MemberProfile", "UswagEvent"
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

// Stores browser PushSubscription objects per user so the server can
// send Web Push notifications to any of their registered devices.
// endpoint is unique — if a browser re-subscribes it gets a new endpoint,
// and the old row is cleaned up automatically when the push returns HTTP 410.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique // the browser-assigned push URL
  p256dh    String           // client public key (base64url)
  auth      String           // auth secret (base64url)
  createdAt DateTime @default(now())

  @@index([userId])
}

// A person's in-app inbox. One row per recipient (the bell and the notifications page read it);
// the same event also goes out as a Web Push to their registered devices (notification.service.ts),
// but the inbox is the record, so it works when push is off, blocked or unsupported. Wording stays
// plain and non-sensitive: push payloads pass through the browser vendor's push service.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String    // "announcement" | "event" | "membership"
  title     String
  body      String
  url       String?   // in-app path to open, e.g. "/dashboard/events"
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Finance ledger — written by Treasurer, read by Treasurer + Auditor + Super Admin.
// Positive amount = income (dues), negative = expense.
// Per Article VI §3(b) the Treasurer is the sole officer who may record entries;
// the Auditor has read-only access enforced via requireOfficerPosition in finance.routes.ts.
model FinanceEntry {
  id               String   @id @default(uuid())
  type             String   // "DUES" | "EXPENSE"
  description      String
  amount           Float    // positive for income, negative for expenses
  relatedMemberId  String?  // links a DUES entry to the paying member (MemberProfile.id)
  recordedById     String
  recordedBy       User     @relation(fields: [recordedById], references: [id])
  createdAt        DateTime @default(now())

  @@index([recordedById])
  @@index([createdAt])
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Procurement workflow for Business Manager
model PurchaseRequest {
  id          String                @id @default(uuid())
  item        String
  estimatedCost Float
  event       String?               // related event name
  status      PurchaseRequestStatus @default(PENDING)
  requestedById String
  requestedBy User                  @relation(fields: [requestedById], references: [id])
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([requestedById])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactInfo String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// The site-wide maintenance switch: ONE row (id = 1), flipped from the developer's /dev console or
// scripts/maintenance.ts. In the database rather than memory or an env var because a deploy restarts the
// server, and the switch has to survive exactly that. While `enabled`, the API answers everything except
// the status check, /health and the developer's own sign-in with 503 (middlewares/maintenance.middleware.ts).
// endsAt is only an estimate shown to visitors: it never reopens the site by itself.
model SiteMaintenance {
  id        Int       @id @default(1)
  enabled   Boolean   @default(false)
  startedAt DateTime?
  endsAt    DateTime?
  message   String?
  setById   String?   // the developer account that last changed it (no relation: it must never block deleting a user)
  updatedAt DateTime  @updatedAt
}
