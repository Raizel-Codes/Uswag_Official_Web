# Copy this file to .env and fill in real values. Never commit .env.

# On the host, set NODE_ENV=production. PORT is usually provided by Railway/Render itself.
PORT=4000
NODE_ENV=development

# The app talks to the database through DATABASE_URL (for Supabase: the transaction pooler, port 6543,
# with ?pgbouncer=true). Prisma migrations need a direct / session connection instead (Supabase: the
# session pooler, port 5432) in DIRECT_URL. Required wherever `prisma migrate` runs; for a local
# database both can be the same URL.
DATABASE_URL="postgresql://user:password@localhost:5432/uswag?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/uswag?schema=public"

# Generate every secret below fresh for production, never reuse the development ones. One line, any OS:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# (for the two student-ID keys use randomBytes(32), which is what they require).

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR signing — HMAC secret used to sign/verify member QR payloads.
# See src/services/qr.service.ts and src/utils/crypto.ts.
# Rotate carefully: rotating invalidates all previously issued QR codes.
QR_SIGNING_SECRET=

# Student ID protection — see src/utils/crypto.ts. Two DIFFERENT keys,
# each 32 random bytes, base64 (openssl rand -base64 32). Back them up:
# losing STUDENT_ID_HASH_KEY breaks duplicate-application detection;
# losing STUDENT_ID_ENC_KEY makes pending applicants' IDs unreadable.
STUDENT_ID_HASH_KEY=
STUDENT_ID_ENC_KEY=

# Meta Graph API — Facebook Page sync (read-only). Do not expose to frontend.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Email — password-reset links. Optional, but without it nobody can reset a forgotten password by email.
# Uses Resend over HTTPS (works on Render/Railway free plans; SMTP does not). Free: 3,000/month, 100/day.
# Setup: resend.com -> Domains -> add a domain USWAG controls and add the DNS records it shows (SPF/DKIM),
# then API Keys -> create one ("Sending access"). Mail can only reach other people from a verified domain.
# EMAIL_FROM must be an address on that domain, e.g. USWAG <no-reply@yourdomain.org>.
RESEND_API_KEY=
EMAIL_FROM=

# Web Push (VAPID). Generate a pair once:  npx web-push generate-vapid-keys
# Changing them later drops every member's push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:uswag@nwssu.edu.ph

# File storage (Cloudinary or Supabase Storage — pick one and fill accordingly).
# Not used by the app yet: nothing uploads files today, so these can stay empty for the beta.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS: the ONE address the website is served from, exactly as the browser shows it: https, no path,
# no trailing slash, e.g. https://uswag.vercel.app. Vercel preview URLs are different origins and will
# be blocked unless this is changed to match.
FRONTEND_ORIGIN=http://localhost:5173
