# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://user:password@localhost:5432/uswag?schema=public"

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR signing — HMAC secret used to sign/verify member QR payloads.
# See src/services/qr.service.ts and src/utils/crypto.ts.
# Rotate carefully: rotating invalidates all previously issued QR codes.
QR_SIGNING_SECRET=

# Meta Graph API — Facebook Page sync (read-only). Do not expose to frontend.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:uswag@nwssu.edu.ph

# File storage (Cloudinary or Supabase Storage — pick one and fill accordingly)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
