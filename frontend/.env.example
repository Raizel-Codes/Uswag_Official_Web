# Copy this file to .env and fill in real values. Never commit .env.

# VITE_* values are baked into the site when it is built, so changing one on Vercel needs a redeploy.

# Where the backend API lives. On Vercel set it to the deployed backend, ending in /api/v1, e.g.
# https://uswag-api.onrender.com/api/v1  (if it is missing the site falls back to localhost and every
# request fails). The backend's FRONTEND_ORIGIN must be this site's address.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# The public site's address, e.g. https://uswag.example.org — used for link previews on
# Facebook/Messenger (og:url, og:image). Leave empty locally; set it on Vercel.
VITE_SITE_URL=

# (No Web Push key here: the browser gets the public VAPID key from the API, so it is configured
# once, on the backend, as VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY.)

# Optional score for the front-page prequel film (a licensed 90 s track, e.g. on Cloudinary).
# Leave empty and the film plays silent, with no mute control.
VITE_PREQUEL_MUSIC_URL=

# The site's stage. "beta" shows a beta / testing-phase notice on every page (BetaBanner) and in the
# footer: set it to beta on Vercel for the beta. Leave it empty (or remove it) for the official release,
# then redeploy.
VITE_RELEASE_STAGE=

# Optional: analytics / error tracking keys go here later
